# Application
NODE_ENV=development
PORT=3000

# Data directory for SQLite DB, clones, and caches (relative to project root or absolute)
DATA_DIR=./data

# SQLite database path (default: $DATA_DIR/gitchronicle.db)
# DATABASE_URL=./data/gitchronicle.db

# Analysis limits
MAX_COMMITS=50000
MAX_CLONE_SIZE_MB=500
CLONE_TIMEOUT_MS=300000
ANALYZE_TIMEOUT_MS=600000
MAX_GRAPH_NODES=80
MAX_GRAPH_EDGES=200
MAX_TIMELINE_SAMPLES=200
MAX_COCHANGE_PAIRS=40000
MAX_COCHANGE_FILES_PER_COMMIT=24

# Public-instance abuse controls
# Simultaneous clone+analyse jobs (each costs minutes of CPU and 100s of MB)
MAX_CONCURRENT_ANALYSES=1
# Imports (and retries) allowed per client IP per window
IMPORT_RATE_LIMIT=5
IMPORT_RATE_WINDOW_MS=600000
# Ceiling on total retained clone bytes; 0 disables the check
MAX_TOTAL_CLONE_MB=2000
# Keep clones after analysis. Leave false: analysis output is self-contained,
# and retained clones are the only unbounded growth on the volume.
KEEP_CLONES=false

# Public origin for canonical / Open Graph URLs (set when deploying)
# APP_URL=https://gitchronicle.up.railway.app

# Logging
LOG_LEVEL=info
